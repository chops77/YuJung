rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }

    function validPhoto(photo) {
      return photo == null || (
        photo is map
        && photo.keys().hasOnly(['url', 'publicId'])
        && photo.url is string
        && photo.url.size() <= 1000
        && photo.url.matches('https://res\\.cloudinary\\.com/[^/]+/image/upload/[^?]*memory-wall/[^?]+\\.webp')
        && photo.publicId is string
        && photo.publicId.size() > 0
        && photo.publicId.size() <= 255
        && photo.publicId.matches('memory-wall/.+')
      );
    }

    match /memories/{card} {
      // "Rules are not filters": a LIST query is denied unless its own
      // constraints guarantee compliance — so admins get unrestricted read
      // (moderation lists everything), while guests may only ever read
      // non-hidden cards (the wall query filters hidden == false).
      allow read: if isAdmin() || resource.data.hidden != true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'authorName', 'relation', 'message', 'photo', 'videoUrl', 'hidden', 'createdAt'
        ])
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 60
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 2000
        && request.resource.data.relation is string
        && request.resource.data.relation.size() <= 60
        && validPhoto(request.resource.data.photo)
        && request.resource.data.videoUrl is string
        && request.resource.data.videoUrl.size() <= 500
        && (request.resource.data.videoUrl == ''
          || request.resource.data.videoUrl.matches('https://(www\\.)?(youtube\\.com/(watch\\?v=|shorts/)|youtu\\.be/)[A-Za-z0-9_-]{11}.*'))
        && request.resource.data.hidden == false
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();

      match /comments/{comment} {
        allow read: if isAdmin() || resource.data.hidden != true;
        allow create: if request.auth != null
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.hidden == false
          && request.resource.data.createdAt == request.time;
        allow update, delete: if isAdmin();
      }
    }

    /* Candle lighting: visitors may light repeatedly but at most one candle
       per minute. Enforcement lives here, not in the client:
         • counter may only ever go up by exactly 1 (admins exempt);
         • each increment MUST be paired, in the same transaction, with a
           fresh stamp of candles/counter/lit/{uid} whose lastLitAt ==
           request.time (the client writes serverTimestamp(), so this holds);
         • lit/{uid} itself accepts a stamp only once per cooldown window. */
    function candleStampedThisWrite() {
      return request.auth != null &&
        getAfter(/databases/$(db)/documents/candles/counter/lit/$(request.auth.uid))
          .data.lastLitAt == request.time;
    }

    match /candles/counter {
      allow read: if true;
      allow create: if isAdmin()
        || (request.resource.data.keys().hasOnly(['count'])
            && request.resource.data.count is number
            && request.resource.data.count == 1
            && candleStampedThisWrite());
      allow update: if isAdmin()
        || (request.resource.data.keys().hasOnly(['count'])
            && request.resource.data.count is number
            && request.resource.data.count == resource.data.count + 1
            && candleStampedThisWrite());
    }

    match /candles/counter/lit/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastLitAt'])
        && request.resource.data.lastLitAt == request.time;
      // Later stamps must wait out the cooldown window.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastLitAt'])
        && request.resource.data.lastLitAt == request.time
        && request.time >= resource.data.lastLitAt + duration.value(60, 's');
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
