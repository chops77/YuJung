rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Guest photo uploads: create-only, images only, ≤ 6 MB.
    // Immutable: guests can never modify or delete (prevents tampering & quota abuse).
    match /guest-media/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.size <= 6 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete: if false;
    }

    // Family admins: full access everywhere.
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}