---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, localeNames, type Locale } from '../config';

interface Props { locale: Locale; currentSlug: string; }
const { locale, currentSlug } = Astro.props;

const shortNames: Record<Locale, string> = { en: 'EN', 'zh-tw': '繁', 'zh-cn': '简' };

const links = locales.map((l) => ({
  l,
  href: getRelativeLocaleUrl(l, currentSlug),
  active: l === locale,
  name: localeNames[l],
  short: shortNames[l],
}));
---
<nav aria-label="Language / 語言 / 语言" class="flex shrink-0 items-center gap-1 whitespace-nowrap text-sm">
  {links.map(({ l, href, active, name, short }) =>
    active ? (
      <span aria-current="true" title={name} class="rounded px-2 py-1 font-medium text-ink underline decoration-gold underline-offset-4">
        <span class="sm:hidden">{short}</span>
        <span class="hidden sm:inline">{name}</span>
      </span>
    ) : (
      <a href={href} data-lang={l} title={name} class="rounded px-2 py-1 text-ink/60 hover:text-ink hover:bg-black/5 transition-colors">
        <span class="sm:hidden">{short}</span>
        <span class="hidden sm:inline">{name}</span>
      </a>
    )
  )}
</nav>
<script is:inline>
  document.querySelectorAll<HTMLAnchorElement>('a[data-lang]').forEach((a) =>
    a.addEventListener('click', () => localStorage.setItem('locale', a.dataset.lang!))
  );
</script>