---
import Ornament from './Ornament.astro';

interface Props {
  title: string;
  lede?: string;
  /** Heading level; sizes adapt automatically */
  as?: 'h1' | 'h2';
}
const { title, lede, as: Tag = 'h2' } = Astro.props;
---

<div class="mx-auto max-w-2xl text-center">
  <Tag class:list={[
    'font-serif tracking-wide text-ink',
    Tag === 'h1' ? 'text-4xl' : 'text-2xl sm:text-3xl',
  ]}>{title}</Tag>
  {lede && <p class="mt-3 leading-relaxed text-ink/70">{lede}</p>}
  <Ornament class="mt-5" />
</div>
