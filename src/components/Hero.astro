---
import { t, pick, formatDate } from '../i18n/ui';
import type { Locale } from '../../config';

interface Props { locale: Locale; profile: any; }
const { locale, profile } = Astro.props;
const $t = t(locale);
const initial = pick(profile.name, locale).trim().charAt(0) || '·';
---

<section class="pt-16 pb-14 text-center">
  <p class="kicker text-lg sm:text-xl" data-reveal>{$t('hero.inLovingMemory')}</p>

  <div class="mx-auto mt-10 w-60 sm:w-68" data-reveal style="--reveal-delay: 90ms">
    <!-- Oval cameo with a fine inner ring, inspired by a framed family portrait. -->
    <div class="aspect-[4/5] rounded-[50%] bg-gradient-to-b from-gold/50 to-gold/20 p-[3px] shadow-[var(--shadow-soft)]">
      <div class="relative flex h-full items-center justify-center overflow-hidden rounded-[50%] bg-parchment-deep ring-1 ring-inset ring-gold/35">
        <span class="font-serif text-8xl text-gold/70" aria-hidden="true">{initial}</span>
        {profile.portrait && (
          <img
            src={`${import.meta.env.BASE_URL}${profile.portrait}`}
            alt=""
            width="272" height="340"
            class="absolute inset-0 h-full w-full object-cover"
            loading="eager"
            onerror="this.remove()"
          />
        )}
      </div>
    </div>
  </div>

  <h1 class="mt-8 font-serif text-4xl tracking-wide sm:text-5xl" data-reveal style="--reveal-delay: 180ms">
    {pick(profile.name, locale)}
  </h1>

  <p class="mt-4 text-ink/70" data-reveal style="--reveal-delay: 260ms">
    {formatDate(profile.born, locale)}
    <span class="mx-2 text-gold" aria-hidden="true">·</span>
    {formatDate(profile.passed, locale)}
  </p>

  {pick(profile.epitaph, locale) && (
    <blockquote class="mx-auto mt-9 max-w-xl font-serif text-xl italic leading-relaxed text-ink/80"
                data-reveal style="--reveal-delay: 340ms">
      “{pick(profile.epitaph, locale)}”
    </blockquote>
  )}
</section>
