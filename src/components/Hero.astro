---
import { t, pick, formatDate } from '../i18n/ui';
import type { Locale } from '../config';

interface Props { locale: Locale; profile: any; }
const { locale, profile } = Astro.props;
const $t = t(locale);
---
<section class="pt-14 pb-12 text-center">
  <p class="text-xs uppercase tracking-[0.4em] text-gold-deep">{$t('hero.inLovingMemory')}</p>

  <img
    src={`${import.meta.env.BASE_URL}${profile.portrait}`}
    alt=""
    width="224" height="224"
    class="mx-auto mt-8 h-56 w-56 rounded-full object-cover shadow-md ring-1 ring-black/10"
    loading="eager"
  />

  <h1 class="mt-7 font-serif text-4xl sm:text-5xl tracking-wide">{pick(profile.name, locale)}</h1>
  <p class="mt-4 text-ink/70">
    {formatDate(profile.born, locale)}
    <span class="mx-2 text-gold">·</span>
    {formatDate(profile.passed, locale)}
  </p>

  {pick(profile.epitaph, locale) && (
    <blockquote class="mx-auto mt-8 max-w-xl font-serif text-xl italic leading-relaxed text-ink/80">
      “{pick(profile.epitaph, locale)}”
    </blockquote>
  )}
</section>