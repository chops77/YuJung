---
import { t } from '../i18n/ui';
import type { Locale } from '../config';
import SectionHeader from './SectionHeader.astro';

interface Props {
  locale: Locale;
  photos: { image: string; alt: string }[];
  tracks: { file: string; title: string }[];
  intervalSeconds: number;
}

const { locale, photos, tracks, intervalSeconds } = Astro.props;
const $t = t(locale);
const base = import.meta.env.BASE_URL;

const slides = photos.map(({ image, alt }) => ({ src: `${base}${image}`, alt }));
const playlist = tracks.map(({ file, title }) => ({ src: `${base}${file}`, title }));
---

<section id="slideshow" class="border-t hairline py-14">
  <SectionHeader title={$t('home.slideshowTitle')} />

  <div id="slideshow-stage"
       class="relative mx-auto mt-9 h-[55vh] w-full max-w-5xl overflow-hidden rounded-xl bg-black shadow-[var(--shadow-soft)] md:h-[65vh]"
       data-reveal>
    <img id="slideshow-layer-a" class="slide-layer" alt="" />
    <img id="slideshow-layer-b" class="slide-layer" alt="" aria-hidden="true" />

    <div class="slideshow-controls absolute inset-x-0 bottom-4 flex justify-center gap-2">
      {playlist.length > 0 && (
        <button type="button" id="slideshow-music"
                class="ctrl-btn ctrl-btn-music"
                aria-label={$t('slideshow.playMusic')} title={$t('slideshow.playMusic')}>
          <svg class="icon-play" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>
          <svg class="icon-stop hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
          <span class="music-label">{$t('slideshow.playMusic')}</span>
        </button>
      )}
      <button type="button" id="slideshow-pause"
              class="ctrl-btn"
              aria-label={$t('slideshow.pause')} title={$t('slideshow.pause')}>
        <svg class="icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5" width="3.5" height="14" rx="1"/><rect x="13.5" y="5" width="3.5" height="14" rx="1"/></svg>
        <svg class="icon-resume hidden" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.54.84l10-6.5a1 1 0 0 0 0-1.68l-10-6.5A1 1 0 0 0 8 5.5Z"/></svg>
      </button>
      <button type="button" id="slideshow-fs"
              class="ctrl-btn"
              aria-label={$t('slideshow.fullscreen')} title={$t('slideshow.fullscreen')}>
        <svg class="icon-fs-on" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M8 21H5a2 2 0 0 1-2-2v-3M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
        <svg class="icon-fs-off hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3M16 3v3a2 2 0 0 0 2 2h3M8 21v-3a2 2 0 0 0-2-2H3M16 21v-3a2 2 0 0 1 2-2h3"/></svg>
      </button>
    </div>
  </div>

  <script type="application/json" id="slideshow-data" set:html={JSON.stringify({
    slides,
    playlist,
    intervalMs: intervalSeconds * 1000,
    i18n: {
      playMusic: $t('slideshow.playMusic'),
      stopMusic: $t('slideshow.stopMusic'),
      pause: $t('slideshow.pause'),
      resume: $t('slideshow.resume'),
      fullscreen: $t('slideshow.fullscreen'),
      exitFullscreen: $t('slideshow.exitFullscreen'),
      prev: $t('slideshow.prev'),
      next: $t('slideshow.next'),
    },
  })} />
</section>

<style>
  .slide-layer {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 1s ease;
  }
  .slide-layer.is-active { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .slide-layer { transition: none; }
  }

  .ctrl-btn {
    display: grid;
    place-items: center;
    height: 2.5rem;
    width: 2.5rem;
    border-radius: 9999px;
    color: white;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(4px);
    transition: background-color 0.2s ease;
  }
  .ctrl-btn:hover { background: var(--color-gold-deep, #a8842c); }
  .ctrl-btn-music {
    width: auto;
    grid-auto-flow: column;
    gap: 0.45rem;
    padding-inline: 0.8rem;
  }
  .music-label { font-size: 0.8125rem; font-weight: 600; }

  /* Fullscreen (native or pseudo): no cropping, auto-hiding controls */
  #slideshow-stage.is-fs { border-radius: 0; }
  #slideshow-stage.is-fs .slideshow-controls { transition: opacity 0.3s ease; }
  #slideshow-stage.is-fs.controls-idle .slideshow-controls { opacity: 0; pointer-events: none; }

  /* Pseudo-fullscreen fallback for browsers without the Fullscreen API (iPhone) */
  #slideshow-stage.is-pseudo-fs {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    max-width: none;
    margin: 0;
  }
</style>

<script>
  import('./Slideshow/player').then((m) => m.init());
</script>
