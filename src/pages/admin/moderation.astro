---
// Firebase config is injected at build time from PUBLIC_* env vars —
// same values the main site bundles via src/lib/firebase.ts.
const fb = JSON.stringify({
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY ?? '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN ?? '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID ?? '',
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID ?? '',
  recaptchaSiteKey: import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? '',
});
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title>Moderation · Memorial</title>
<style>
  body{font-family:system-ui;margin:0;background:#f7f3ec;color:#2b2926;padding:24px}
  main{max-width:880px;margin:auto}
  .bar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
  input,select,button{font:inherit;padding:8px 12px;border-radius:8px;border:1px solid #d8d2c4;background:#fff}
  button{cursor:pointer} button.danger{color:#a33} button.warn{color:#a83}
  .card{background:#fff;border:1px solid #00000014;border-radius:12px;padding:16px;margin-bottom:12px}
  .muted{color:#777;font-size:.85em} .hidden-tag{color:#a33;font-weight:600}
  img.guest{max-height:180px;border-radius:8px;display:block;margin-top:8px}
  details{margin-top:8px} .cmt{border-top:1px dashed #ddd;padding:6px 0;display:flex;gap:8px;align-items:start}
</style>
</head>
<body>
<main>
  <div class="bar" id="auth-bar">
    <input id="email" type="email" placeholder="family@email.com" />
    <input id="pw" type="password" placeholder="password" />
    <button id="login">Sign in</button>
    <span id="whoami" class="muted"></span>
  </div>

  <div class="bar" id="tools" hidden>
    <select id="filter">
      <option value="all">All</option>
      <option value="visible">Visible only</option>
      <option value="hidden">Hidden only</option>
    </select>
    <button onclick="loadCards()">Refresh</button>
    <a href="../" style="margin-left:auto">← CMS</a>
    <button id="logout">Sign out</button>
  </div>

  <div id="list"></div>
</main>

<script type="application/json" id="fb-config" set:html={fb} />
<script type="module" is:inline>
  const { apiKey, authDomain, projectId, appId, recaptchaSiteKey }
    = JSON.parse(document.getElementById('fb-config').textContent);
  const firebaseConfig = { apiKey, authDomain, projectId, appId };
  import { initializeApp } from 'https://www.gstatic.com/firebasejs/11.1.0/firebase-app.js';
  import { initializeAppCheck, ReCaptchaV3Provider } from 'https://www.gstatic.com/firebasejs/11.1.0/firebase-app-check.js';
  import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut }
    from 'https://www.gstatic.com/firebasejs/11.1.0/firebase-auth.js';
  import { getFirestore, collection, getDocs, getDoc, doc, updateDoc, deleteDoc,
           query, orderBy, limit }
    from 'https://www.gstatic.com/firebasejs/11.1.0/firebase-firestore.js';

  const app = initializeApp(firebaseConfig);
  // Match the main site: without a valid App Check token every Firestore
  // request is rejected when enforcement is enabled in the console.
  if (recaptchaSiteKey) {
    try {
      initializeAppCheck(app, {
        provider: new ReCaptchaV3Provider(recaptchaSiteKey),
        isAutoRefreshEnabled: true,
      });
    } catch (e) { console.error('app check init failed:', e); }
  }
  const auth = getAuth(app), db = getFirestore(app);

  const $ = id => document.getElementById(id);
  let cards = [];

  $('login').onclick = () =>
    signInWithEmailAndPassword(auth, $('email').value, $('pw').value).catch(e => alert(e.message));
  $('logout').onclick = () => signOut(auth);

  onAuthStateChanged(auth, async u => {
    $('auth-bar').style.display = u ? 'none' : '';
    $('tools').hidden = !u;
    if (!u) return;
    const adm = await getDoc(doc(db, 'admins', u.uid));
    $('whoami').textContent = adm.exists()
      ? `${u.email} ✓ admin`
      : `⚠ ${u.email} — NOT in admins collection (uid: ${u.uid})`;
    loadCards();
  });

  window.loadCards = async function () {
    try {
      const snap = await getDocs(query(collection(db, 'memories'), orderBy('createdAt', 'desc'), limit(300)));
      cards = snap.docs.map(d => ({ id: d.id, ...d.data() }));
      render();
    } catch (e) {
      console.error('loadCards failed:', e);
      alert('Failed to load memories:\n' + (e.message || e));
    }
  };

  function render() {
    const f = $('filter').value;
    const list = $('list'); list.innerHTML = '';
    for (const c of cards.filter(c => f === 'all' || (f === 'hidden') === !!c.hidden)) {
      const art = document.createElement('article'); art.className = 'card';
      art.innerHTML = `
        ${c.hidden ? '<span class="hidden-tag">🚫 HIDDEN</span> ' : ''}
        <strong>${esc(c.authorName)}</strong>${c.relation ? ' · ' + esc(c.relation) : ''}
        <span class="muted">· ${c.createdAt?.toDate?.().toLocaleString() ?? ''}</span>
        <p style="white-space:pre-line;margin:8px 0">${esc(c.message)}</p>
        ${c.photo ? `<a href="${esc(c.photo.url)}" target="_blank" rel="noopener"><img class="guest" src="${esc(c.photo.url)}"></a>
          <p class="muted">Cloudinary: <code>${esc(c.photo.publicId)}</code>
          <button type="button" data-act="copy-photo">Copy ID</button></p>` : ''}
        ${c.videoUrl ? `<p class="muted">Video: <a href="${esc(c.videoUrl)}" target="_blank" rel="noopener">${esc(c.videoUrl)}</a></p>` : ''}
        <div class="bar">
          <button class="${c.hidden ? '' : 'warn'}" data-act="toggle">${c.hidden ? 'Unhide' : 'Hide'}</button>
          <button data-act="edit">Edit message</button>
          <button class="danger" data-act="del">Delete</button>
        </div>
        <details><summary class="muted">Comments</summary><div class="cmts muted">Loading…</div></details>`;

      const [toggleBtn, editBtn, delBtn] = art.querySelectorAll('div.bar button');
      const copyPhotoBtn = art.querySelector('[data-act="copy-photo"]');
      if (copyPhotoBtn) copyPhotoBtn.onclick = () => navigator.clipboard.writeText(c.photo.publicId);
      toggleBtn.onclick = () => updateDoc(doc(db, 'memories', c.id), { hidden: !c.hidden })
        .then(loadCards).catch(alert);
      editBtn.onclick = () => {
        const v = prompt('Edit message:', c.message); if (v == null) return;
        updateDoc(doc(db, 'memories', c.id), { message: v.trim() }).then(loadCards).catch(alert);
      };
      delBtn.onclick = async () => {
        const photoNote = c.photo ? `\n\nIts Cloudinary photo will remain. Delete it separately if desired.\nCloudinary ID: ${c.photo.publicId}` : '';
        if (!confirm('Permanently delete this memory and its comments?' + photoNote)) return;
        const cs = await getDocs(collection(db, 'memories', c.id, 'comments'));
        await Promise.all(cs.docs.map(x => deleteDoc(x.ref)));
        await deleteDoc(doc(db, 'memories', c.id));
        loadCards();
      };

      const det = art.querySelector('details');
      det.addEventListener('toggle', async () => {
        if (!det.open || det.dataset.done) return; det.dataset.done = 1;
        const box = det.querySelector('.cmts'); box.innerHTML = '';
        const cs = await getDocs(collection(db, 'memories', c.id, 'comments'));
        for (const x of cs.docs) {
          const cm = x.data();
          const row = document.createElement('div'); row.className = 'cmt';
          row.innerHTML = `<span style="flex:1">${cm.hidden ? '🚫 ' : ''}<strong>${esc(cm.authorName)}</strong>: ${esc(cm.text)}</span>
            <button class="${cm.hidden ? '' : 'warn'}" data-a="t">${cm.hidden ? 'Unhide' : 'Hide'}</button>
            <button class="danger" data-a="d">Del</button>`;
          const [tbtn, dbtn] = row.querySelectorAll('button');
          tbtn.onclick = () => updateDoc(x.ref, { hidden: !cm.hidden })
            .then(() => { det.dataset.done = ''; det.open = false; }).catch(alert);
          dbtn.onclick = () => confirm('Delete comment?') && deleteDoc(x.ref)
            .then(() => row.remove()).catch(alert);
          box.append(row);
        }
        if (!box.children.length) box.textContent = '(none)';
      });
      list.append(art);
    }
    if (!list.children.length) list.textContent = 'No entries.';
  }

  function esc(s) {
    return String(s ?? '').replace(/[&<>"']/g,
      c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  }
  $('filter').onchange = render;
</script>
</body>
</html>
