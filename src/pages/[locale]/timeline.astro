---
import { getCollection, getEntry } from 'astro:content';
import { locales, type Locale } from '../../config';
import { t, pick, formatDate } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const settings = (await getEntry('settings', 'settings'))!.data;
if (!settings.sections.timeline) return Astro.redirect(`/${locale}/`);

const $t = t(locale);
const items = (await getCollection('timeline')).sort((a, b) =>
  (a.data.order || 0) - (b.data.order || 0) ||
  a.data.date.valueOf() - b.data.date.valueOf()
);
---
<Base title={$t('nav.timeline')}>
  <section class="py-10">
    <h1 class="text-center font-serif text-4xl">{$t('home.timelineTitle')}</h1>

    <ol class="relative mx-auto mt-12 max-w-2xl list-none space-y-14 border-l-2 hairline pl-8 md:pl-12">
      {items.map(({ data }) => (
        <li class="relative">
          <span aria-hidden="true"
                class="absolute -left-[41px] top-1 h-4 w-4 rounded-full border-2 border-gold bg-parchment md:-left-[57px]"></span>

          <time datetime={data.date.toISOString().slice(0, 10)}
                class="text-sm font-semibold uppercase tracking-wider text-gold-deep">
            {formatDate(data.date, locale)}
          </time>
          <h2 class="mt-1.5 font-serif text-2xl">{pick(data.title, locale)}</h2>

          {data.image && (
            <img src={`${import.meta.env.BASE_URL}${data.image}`}
                 alt={pick(data.title, locale)}
                 loading="lazy"
                 class="mt-4 w-full max-w-md rounded-lg object-cover shadow-sm ring-1 ring-black/10" />
          )}

          <p class="mt-3 max-w-xl leading-relaxed text-ink/80 whitespace-pre-line">
            {pick(data.text, locale)}
          </p>
        </li>
      ))}
    </ol>
  </section>
</Base>