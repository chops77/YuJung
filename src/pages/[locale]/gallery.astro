---
import { getCollection, getEntry } from 'astro:content';
import { locales, type Locale } from '../../config';
import { t, pick } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const settings = (await getEntry('settings', 'settings'))!.data;
if (!settings.sections.gallery) return Astro.redirect(`/${locale}/`);

const $t = t(locale);
const photos = (await getCollection('photos')).sort((a, b) => a.data.order - b.data.order);
const videos = (await getCollection('videos')).sort((a, b) => a.data.order - b.data.order);
---
<Base title={$t('nav.gallery')}>
  <section class="py-12">
    <SectionHeader as="h1" title={$t('gallery.photos')} />
    <div class="mt-10 columns-2 gap-4 md:columns-3 [&>*]:mb-4 break-inside-avoid">
      {photos.map(({ data }, i) => (
        <figure class="group break-inside-avoid" data-reveal style={`--reveal-delay:${Math.min(i % 6, 5) * 70}ms`}>
          <div class="overflow-hidden rounded-xl ring-1 ring-black/10 shadow-[var(--shadow-soft)] transition-shadow duration-300 group-hover:shadow-[var(--shadow-lift)]">
            <img data-lightbox
                 src={`${import.meta.env.BASE_URL}${data.image}`}
                 alt={pick(data.alt, locale)}
                 loading="lazy"
                 class="w-full cursor-zoom-in transition-transform duration-500 ease-out group-hover:scale-[1.04]" />
          </div>
          {pick(data.caption, locale) && (
            <figcaption class="mt-2 text-center text-xs tracking-wide text-ink/60">{pick(data.caption, locale)}</figcaption>
          )}
        </figure>
      ))}
    </div>
  </section>

  {videos.length > 0 && (
    <section class="border-t hairline py-12">
      <SectionHeader title={$t('gallery.videos')} />
      <div class="mt-9 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {videos.map(({ data }, i) => (
          <button
            class="video-facade group relative aspect-video cursor-pointer overflow-hidden rounded-xl bg-black shadow-[var(--shadow-soft)] transition-shadow duration-300 hover:shadow-[var(--shadow-lift)]"
            data-video-id={data.youtubeId}
            aria-label={pick(data.title, locale) || $t('gallery.videos')}
            data-reveal style={`--reveal-delay:${Math.min(i % 6, 5) * 70}ms`}
          >
            <img src={`https://i.ytimg.com/vi/${data.youtubeId}/hqdefault.jpg`}
                 alt="" loading="lazy"
                 class="h-full w-full object-cover opacity-90 transition duration-500 ease-out group-hover:scale-[1.04] group-hover:opacity-100" />
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="grid h-14 w-14 place-items-center rounded-full bg-black/65 text-white ring-1 ring-white/30 backdrop-blur-sm transition duration-300 group-hover:bg-gold-deep group-hover:ring-white/50" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.54.84l10-6.5a1 1 0 0 0 0-1.68l-10-6.5A1 1 0 0 0 8 5.5Z"/></svg>
              </span>
            </span>
            {pick(data.title, locale) && (
              <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-2.5 pt-8 text-left text-sm text-white">
                {pick(data.title, locale)}
              </span>
            )}
          </button>
        ))}
      </div>
    </section>
  )}

  <script>
    // Video facades → swap thumbnail for real embed only on click
    document.querySelectorAll<HTMLButtonElement>('.video-facade').forEach((btn) => {
      btn.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.videoId}?autoplay=1&rel=0`;
        iframe.allow = 'autoplay; encrypted-media; picture-in-picture;';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label') ?? 'Video';
        iframe.className = 'h-full w-full';
        btn.replaceWith(iframe);
      });
    });

    // Lightbox (shared pattern with memory wall)
    const dlg = document.createElement('dialog');
    dlg.id = 'lightbox';
    dlg.className = 'm-auto max-w-[92vw] bg-transparent p-0 backdrop:bg-black/75';
    dlg.addEventListener('click', () => dlg.close());
    document.body.append(dlg);
    document.querySelectorAll<HTMLImageElement>('img[data-lightbox]').forEach((img) => {
      img.addEventListener('click', () => {
        dlg.innerHTML = '';
        const big = document.createElement('img');
        big.src = img.src; big.alt = img.alt;
        big.className = 'mx-auto max-h-[88vh] rounded-lg shadow-2xl';
        dlg.append(big);
        dlg.showModal();
      });
    });
  </script>
</Base>