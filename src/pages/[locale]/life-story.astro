---
import { getEntry } from 'astro:content';
import { locales, type Locale } from '../../config';
import { t, pick } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const settings = (await getEntry('settings', 'settings'))!.data;
if (!settings.sections.lifeStory) return Astro.redirect(`/${locale}/`);

const profile = (await getEntry('profile', 'profile'))!.data;
const $t = t(locale);
const bio = pick(profile.biography, locale);
const initial = pick(profile.name, locale).trim().charAt(0) || '·';
---
<Base title={$t('nav.lifeStory')}>
  <article class="py-12">
    <SectionHeader as="h1" title={$t('home.biographyTitle')} />

    {pick(profile.epitaph, locale) && (
      <blockquote class="mx-auto mt-9 max-w-xl text-center font-serif text-xl italic leading-relaxed text-ink/70"
                  data-reveal>
        “{pick(profile.epitaph, locale)}”
      </blockquote>
    )}

    <div class="mx-auto mt-12 max-w-[68ch] leading-loose text-ink/85 whitespace-pre-line
                first-letter:float-left first-letter:mr-3 first-letter:font-serif
                first-letter:text-6xl first-letter:leading-[0.85] first-letter:text-gold"
         data-reveal>
      {bio}
    </div>

    {profile.portrait && (
      <div class="mx-auto mt-14 w-64" data-reveal>
        <!-- Oval cameo matching the homepage portrait. -->
        <div class="aspect-[4/5] rounded-[50%] bg-gradient-to-b from-gold/50 to-gold/20 p-[3px] shadow-[var(--shadow-soft)]">
          <div class="relative flex h-full items-center justify-center overflow-hidden rounded-[50%] bg-parchment-deep ring-1 ring-inset ring-gold/35">
            <span class="font-serif text-7xl text-gold/70" aria-hidden="true">{initial}</span>
            <img
              src={`${import.meta.env.BASE_URL}${profile.portrait}`}
              alt={pick(profile.name, locale)}
              width="256" height="320"
              loading="lazy"
              class="absolute inset-0 h-full w-full object-cover"
              onerror="this.remove()"
            />
          </div>
        </div>
      </div>
    )}
  </article>
</Base>
