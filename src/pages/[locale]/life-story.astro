---
import { getEntry } from 'astro:content';
import { locales, type Locale } from '../../config';
import { t, pick } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export function getStaticParams() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const settings = (await getEntry('settings', 'settings'))!.data;
if (!settings.sections.lifeStory) return Astro.redirect(`/${locale}/`);

const profile = (await getEntry('profile', 'profile'))!.data;
const $t = t(locale);
const bio = pick(profile.biography, locale);
---
<Base title={$t('nav.lifeStory')}>
  <article class="py-10">
    <header class="text-center">
      <h1 class="font-serif text-4xl">{$t('home.biographyTitle')}</h1>
      <p class="mt-3 font-serif text-lg italic text-ink/60">“{pick(profile.epitaph, locale)}”</p>
      <div class="mx-auto mt-6 h-px w-16 bg-gold"></div>
    </header>

    <div class="mx-auto mt-10 max-w-2xl leading-loose text-ink/85 whitespace-pre-line
                first-letter:float-left first-letter:mr-2 first-letter:font-serif
                first-letter:text-6xl first-letter:leading-[0.9] first-letter:text-gold">
      {bio}
    </div>

    {profile.portrait && (
      <img
        src={`${import.meta.env.BASE_URL}${profile.portrait}`}
        alt={pick(profile.name, locale)}
        width="480" height="480"
        loading="lazy"
        class="mx-auto mt-12 w-72 rounded-lg object-cover shadow-md ring-1 ring-black/10"
      />
    )}
  </article>
</Base>