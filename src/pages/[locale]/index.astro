---
import { getCollection, getEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, intlLocale, type Locale } from '../../config';
import { t, pick, formatDate } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import Slideshow from '../../components/Slideshow.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const $t = t(locale);

const settings = (await getEntry('settings', 'settings'))!.data;
const profile = (await getEntry('profile', 'profile'))!.data;

const timelineOn = settings.sections.timeline;
const timelineItems = timelineOn
  ? (await getCollection('timeline'))
      .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
      .slice(-3).reverse()
  : [];

const serviceOn = settings.sections.service;
const service = serviceOn ? (await getEntry('service', 'service'))?.data : undefined;

const slideshowOn = settings.sections.slideshow;
const slideshowPhotos = slideshowOn
  ? (await getCollection('photos'))
      .sort((a, b) => a.data.order - b.data.order)
      .map(({ data }) => ({ image: data.image, alt: pick(data.alt, locale) }))
  : [];
const slideshowTracks = slideshowOn
  ? (await getCollection('music'))
      .filter(({ data }) => data.active)
      .sort((a, b) => a.data.order - b.data.order)
      .map(({ data }) => ({ file: data.file, title: data.title }))
  : [];

const bioText = pick(profile.biography, locale);
const bioExcerpt = bioText.length > 320 ? bioText.slice(0, 320).trimEnd() + '…' : bioText;
---
<Base>
  <Hero locale={locale} profile={profile} />

  {bioExcerpt && settings.sections.lifeStory && (
    <section class="border-t hairline py-14">
      <SectionHeader title={$t('home.biographyTitle')} />
      <p class="mx-auto mt-6 max-w-3xl leading-loose text-ink/80 whitespace-pre-line"
         data-reveal>{bioExcerpt}</p>
      <p class="mt-5 text-center" data-reveal>
        <a class="inline-flex items-center gap-1.5 text-[15px] font-medium text-gold-deep underline decoration-gold/50 underline-offset-4 transition-colors hover:text-ink"
           href={getRelativeLocaleUrl(locale, 'life-story')}>
          {$t('common.readMore')}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </p>
    </section>
  )}

  {timelineItems.length > 0 && (
    <section class="border-t hairline py-14">
      <SectionHeader title={$t('home.timelineTitle')} />
      <ol class="mt-9 grid list-none gap-5 sm:grid-cols-3">
        {timelineItems.map(({ data }, i) => (
          <li class="card group p-5 transition-shadow duration-300 hover:shadow-[var(--shadow-lift)]"
              data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <time class="inline-block rounded-full border hairline bg-white/70 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-gold-deep"
                  datetime={data.date.toISOString().slice(0, 10)}>
              {formatDate(data.date, locale)}
            </time>
            <h3 class="mt-2.5 font-serif text-lg">{pick(data.title, locale)}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-ink/70 line-clamp-4">{pick(data.text, locale)}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  {slideshowPhotos.length > 0 && (
    <Slideshow
      locale={locale}
      photos={slideshowPhotos}
      tracks={slideshowTracks}
      intervalSeconds={settings.slideshow.intervalSeconds}
    />
  )}

  {settings.sections.memories && (
    <section class="border-t hairline py-14">
      <SectionHeader title={$t('home.memoriesCta')} />

      <script type="application/json" id="memory-i18n" set:html={JSON.stringify({
        langTag: intlLocale(locale),
        'wall.error': $t('wall.error'),
      })} />

      <div id="memory-preview" aria-busy="true"
           class="mt-9 grid gap-5 text-left md:grid-cols-3">
        {[0, 1, 2].map(() => (
          <div class="card p-5 motion-safe:animate-pulse" aria-hidden="true">
            <div class="h-4 w-1/3 rounded bg-black/10"></div>
            <div class="mt-4 h-3 w-full rounded bg-black/5"></div>
            <div class="mt-2 h-3 w-full rounded bg-black/5"></div>
            <div class="mt-2 h-3 w-2/3 rounded bg-black/5"></div>
          </div>
        ))}
      </div>
      <p id="memory-preview-status" class="mt-4 min-h-[1.5rem] text-center text-sm text-ink/50" aria-live="polite"></p>

      <p class="mt-5 text-center">
        <a class="btn-primary" href={getRelativeLocaleUrl(locale, 'memories')}>
          {$t('home.enterMemories')}
        </a>
      </p>

      <script>
        import('../../components/MemoryWall/preview').then(m =>
          m.initPreview(JSON.parse(document.getElementById('memory-i18n')!.textContent!)));
      </script>
    </section>
  )}

  {service && (
    <section class="border-t hairline py-14">
      <SectionHeader title={$t('home.serviceCard')} />
      <div class="card mx-auto mt-8 max-w-xl space-y-5 p-7" data-reveal>
        <div class="flex items-start gap-4">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-gold/10 text-gold-deep ring-1 ring-gold/25" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          </span>
          <p class="pt-1 font-serif text-xl tracking-wide">
            {service.date.toLocaleDateString({ en: 'en-US', 'zh-tw': 'zh-TW', 'zh-cn': 'zh-CN' }[locale], { dateStyle: 'long' })}
            {service.time && <span class="text-gold-deep"> · {service.time}</span>}
          </p>
        </div>
        <div class="flex items-start gap-4">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-gold/10 text-gold-deep ring-1 ring-gold/25" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div class="pt-0.5">
            <p class="text-[17px] text-ink/85">{pick(service.venue, locale)}</p>
            {pick(service.address, locale) && <p class="text-sm leading-relaxed text-ink/60">{pick(service.address, locale)}</p>}
          </div>
        </div>
        {service.mapsUrl && (
          <p class="pt-1 text-center">
            <a class="btn-outline" href={service.mapsUrl} target="_blank" rel="noopener">
              {$t('service.where')}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
            </a>
          </p>
        )}
      </div>
    </section>
  )}
</Base>
