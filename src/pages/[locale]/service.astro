---
import { getEntry } from 'astro:content';
import { locales, type Locale } from '../../config';
import { t, pick, formatDate } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';
import SectionHeader from '../../components/SectionHeader.astro';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const settings = (await getEntry('settings', 'settings'))!.data;
if (!settings.sections.service) return Astro.redirect(`/${locale}/`);

const service = (await getEntry('service', 'service'))?.data;
if (!service) return Astro.redirect(`/${locale}/`);

const $t = t(locale);
// Inline parse (server-side) — don't import lib/firebase.ts here; it has browser side effects.
const ytId = service.livestreamUrl?.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/)|youtu\.be\/)([\w-]{11})/)?.[1];
---
<Base title={$t('nav.service')}>
  <section class="py-12">
    <SectionHeader as="h1" title={$t('nav.service')} />

    <div class="card mx-auto mt-10 max-w-xl space-y-6 p-8" data-reveal>
      <div class="flex items-start gap-4">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-gold/10 text-gold-deep ring-1 ring-gold/25" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="3"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        </span>
        <div>
          <p class="kicker !tracking-[0.22em]">{$t('service.when')}</p>
          <p class="mt-1 font-serif text-2xl tracking-wide">
            {formatDate(service.date, locale)}
            {service.time && <span class="text-gold-deep"> · {service.time}</span>}
          </p>
        </div>
      </div>

      <div class="flex items-start gap-4 border-t hairline pt-6">
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-gold/10 text-gold-deep ring-1 ring-gold/25" aria-hidden="true">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        </span>
        <div>
          <p class="kicker !tracking-[0.22em]">{$t('service.where')}</p>
          <p class="mt-1 text-lg text-ink/85">{pick(service.venue, locale)}</p>
          {pick(service.address, locale) && <p class="mt-0.5 leading-relaxed text-ink/60">{pick(service.address, locale)}</p>}
        </div>
      </div>

      {(service.mapsUrl || service.livestreamUrl) && (
        <div class="flex flex-wrap justify-center gap-3 border-t hairline pt-6">
          {service.mapsUrl && (
            <a href={service.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-outline">
              {$t('service.where')}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
            </a>
          )}
          {service.livestreamUrl && !ytId && (
            <a href={service.livestreamUrl} target="_blank" rel="noopener noreferrer"
               class="btn-primary !px-5 !py-2 !text-sm">
              {$t('service.livestream')}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="inline-block"><path d="M7 17L17 7M8 7h9v9"/></svg>
            </a>
          )}
        </div>
      )}
    </div>

    {ytId && (
      <div class="mx-auto mt-12 aspect-video max-w-3xl overflow-hidden rounded-xl shadow-[var(--shadow-lift)] ring-1 ring-black/10" data-reveal>
        <iframe src={`https://www.youtube-nocookie.com/embed/${ytId}`}
                title={$t('service.livestream')}
                allow="encrypted-media; picture-in-picture;" allowfullscreen
                class="h-full w-full"></iframe>
      </div>
    )}
  </section>
</Base>